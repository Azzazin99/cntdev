# Admin login (username: admin)
# บน Vercel: Settings → Environment Variables — ต้องใส่ค่าจริง (ไม่ใช่ชื่อเปล่า)
#   ADMIN_PASSWORD, AUTH_SESSION_SECRET → Production + Preview + Development แล้ว Redeploy
# Local: ใส่ค่าใน .env.local ด้วยมือ (vercel env pull อาจได้ค่าว่างสำหรับ sensitive)
#   หรือ vercel env pull .env.local --environment=production แล้วเติม ADMIN_PASSWORD เอง
ADMIN_PASSWORD=your-admin-password
AUTH_SESSION_SECRET=change-this-to-a-long-random-string

# Legacy names (still work if you already set these on Vercel):
# LOCAL_AUTH_PASSWORD=...
# LOCAL_AUTH_SESSION_SECRET=...

# Cloudflare Turnstile (optional — skip if unset; required on production for bot protection)
# Dashboard: Cloudflare → Turnstile → Add site
# Hostnames: cntdev.vercel.app, localhost
# Widget mode: Managed
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Firebase Admin — required on Vercel for read/write content (news, activities, site lists, personnel)
# Download: Firebase Console → Project cntdev-e49f5 → Settings → Service accounts → Generate new private key
# Paste the entire JSON on one line (no line breaks). Same value for Production + Preview on Vercel.
# Initial upload from JSON: python migrate_to_firebase.py  (uses serviceAccountKey.json or this env var)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Vercel Blob — PDF ข่าว + รูปกิจกรรม/บุคลากรจาก admin
# Vercel Dashboard → Storage → Create Blob (Public) → เชื่อมโปรเจกต์ cntdev
# โปรเจกต์ใหม่ได้ BLOB_STORE_ID + OIDC อัตโนมัติ
# อัปโหลดจาก admin ในเบราว์เซอร์ (PDF ข่าว / รูป) ต้องมี BLOB_READ_WRITE_TOKEN ด้วย — สร้างใน Blob store → Projects → cntdev
# Local: vercel env pull .env.local --environment=production แล้ว restart npm run dev
# Setup: docs/vercel-blob-setup.html
# BLOB_READ_WRITE_TOKEN=   # จำเป็นสำหรับ client upload; OIDC อย่างเดียวไม่พอ
