# Admin login (password only — set on Vercel Production + Preview, then Redeploy)
ADMIN_PASSWORD=your-admin-password
AUTH_SESSION_SECRET=change-this-to-a-long-random-string

# Legacy names (still work if you already set these on Vercel):
# LOCAL_AUTH_PASSWORD=...
# LOCAL_AUTH_SESSION_SECRET=...

# Firebase Admin — required on Vercel for read/write content (news, activities, site lists, personnel)
# Download: Firebase Console → Project cntdev-e49f5 → Settings → Service accounts → Generate new private key
# Paste the entire JSON on one line (no line breaks). Same value for Production + Preview on Vercel.
# Initial upload from JSON: python migrate_to_firebase.py  (uses serviceAccountKey.json or this env var)
FIREBASE_SERVICE_ACCOUNT_JSON=
